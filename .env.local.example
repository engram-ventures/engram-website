# Resend API key for contact form emails
# Get your key at https://resend.com
# Add your domain (engramventures.com) in Resend → Domains, then verify DNS
RESEND_API_KEY=re_your_api_key_here

# Google Analytics 4 Measurement ID
# Create at https://analytics.google.com → Admin → Data Streams → Web
# Format: G-XXXXXXXXXX. Leave empty (or omit) to disable analytics in dev.
NEXT_PUBLIC_GA_ID=
